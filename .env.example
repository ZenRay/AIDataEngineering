# MCP 服务器配置模板（复制为 .env 后填入真实值）
# ⚠️ 此文件是模板，不包含真实 token

# MySQL MCP 服务器（测试环境）
export MYSQL_MCP_URL="http://your-mysql-mcp-server/mcp"
export MYSQL_MCP_TOKEN="your-mysql-token-here"

# Nacos MCP 服务器（测试环境）
export NACOS_MCP_URL="https://your-nacos-mcp-server/mcp"
export NACOS_MCP_TOKEN="your-nacos-token-here"

# ── GitLab MCP（原生端点 /api/v4/mcp，OAuth 认证）──────────
# 无 token 变量：认证走 OAuth 2.1（mcp scope），长期凭据由 Claude Code 保管、不落盘
# HTTP 传输需 GitLab ≥ 18.6（19.5 起 GA）
# 真实内网 host 走线下渠道索取，不写入本模板（与 .gitmodules/.meta 别名脱敏同一纪律）
# 填好后：direnv reload → 从该 shell 重启 claude → 批准 server → /mcp → gitlab → Authenticate
export GITLAB_MCP_URL=https://gitlab.example.com/api/v4/mcp
