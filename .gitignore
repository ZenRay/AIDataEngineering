# 数据建设 repo（meta 管理，Phase 2 起启用；meta 也会自动维护本文件）
projects/

# 个人存档区（长期受限目录：Read ask / archive Read deny / Edit deny，由 .claude/settings.json 强制）
BackDocs/

# direnv 本地缓存（.envrc 本身提交，缓存不提交）
.direnv/

# 环境变量文件（包含敏感信息，不提交）
.env
.env.local
.env.*.local

# 个人本地配置（永不提交）
.claude/settings.local.json
CLAUDE.local.md
/projects/nl2sql-backend/

# Git worktree 工作区（每个 worktree 是独立的工作目录，不提交）
.worktrees/
/projects/code-parser/

submodules/
LearningNote/
research/