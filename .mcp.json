{
  "mcpServers": {
    "bg-mysql-mcp": {
      "type": "http",
      "url": "${MYSQL_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${MYSQL_MCP_TOKEN}"
      }
    },
    "nacos-mcp-j-test": {
      "type": "http",
      "url": "https://mcp-nacos.biaoguoworks.com/mcp",
      "headers": {
        "X-Nacos-Environment": "test",
        "Authorization": "Bearer ${NACOS_MCP_TOKEN}"
      }
    }
  }
}
