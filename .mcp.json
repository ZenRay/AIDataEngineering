{
  "mcpServers": {
    "bg-mysql-mcp-prod": {
      "type": "http",
      "url": "${MYSQL_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${MYSQL_MCP_TOKEN}"
      }
    },
    "bg-mysql-mcp-test": {
      "type": "http",
      "url": "${MYSQL_MCP_URL_TEST}",
      "headers": {
        "Authorization": "Bearer ${MYSQL_MCP_TOKEN_TEST}"
      }
    },
    "bg-nacos-mcp-test": {
      "type": "http",
      "url": "${NACOS_MCP_URL}",
      "headers": {
        "X-Nacos-Environment": "test",
        "Authorization": "Bearer ${NACOS_MCP_TOKEN}"
      }
    },
    "gitlab": {
      "type": "http",
      "url": "${GITLAB_MCP_URL}"
    }
  }
}
