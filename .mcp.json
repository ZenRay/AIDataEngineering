{
  "mcpServers": {
    "bg-mysql-mcp": {
      "type": "http",
      "url": "${MYSQL_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${MYSQL_MCP_TOKEN}"
      }
    },
    "bg-nacos-mcp-test": {
      "type": "http",
      "url": "${NACOS_MCP_URL}",
      "headers": {
        "X-Nacos-Environment": "test",
        "Authorization": "Bearer ${NACOS_MCP_TOKEN}"
      }
    }
  }
}
