# 临时测试时可直接设置，但提交前必须移除或改用安全注入方式
export MYSQL_MCP_URL="http://mcp-mysql.ack-test.biaoguoworks.com/mcp"
export MYSQL_MCP_TOKEN="UCNEXR8LL3Rh9f"  # ⚠️ 测试 token，生产环境需替换为安全注入

